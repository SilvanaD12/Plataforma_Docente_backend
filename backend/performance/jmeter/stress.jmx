      <hashTree/>
      <JSR223Listener guiclass="TestBeanGUI" testclass="JSR223Listener" testname="Breaking Point Monitor" enabled="true">
        <stringProp name="scriptLanguage">groovy</stringProp>
        <stringProp name="parameters"></stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="script">
def tgName = ctx.getThreadGroup().getName();
def isError = false;
def code = sampleResult.getResponseCode();
if (code != null &amp;&amp; (code.startsWith("5") || !sampleResult.isSuccessful())) {
    isError = true;
}
def stats = props.get("STATS_" + tgName);
if (stats == null) {
    stats = [total: 0L, errors: 0L, p95exceeded: 0L, start_time: sampleResult.getStartTime()];
    props.put("STATS_" + tgName, stats);
}
stats.total++;
if (isError) {
    stats.errors++;
}
long p95LimitMs = ${__P(p95_limit_ms,5000)}L;
double errLimitPct = ${__P(error_limit_pct,5)}.0;
long minTierSec = ${__P(min_tier_seconds,30)}L;
long minTierSamples = ${__P(min_tier_samples,300)}L;
if (sampleResult.getTime() > p95LimitMs) {
    stats.p95exceeded++;
}
long elapsedSec = (sampleResult.getEndTime() - stats.start_time) / 1000L;
if (stats.total >= minTierSamples &amp;&amp; elapsedSec >= minTierSec) {
    double errPct = (stats.errors * 100.0) / stats.total;
    double slowPct = (stats.p95exceeded * 100.0) / stats.total;
    if (errPct > errLimitPct || slowPct > errLimitPct) {
        props.put("BREAKING_POINT_REACHED", "true");
        props.put("BREAKING_TIER", tgName);
    }
}
        </stringProp>
      </JSR223Listener>
      <hashTree/>

      <!-- Tier 1: 50 Threads -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Tier-1-50-Threads" enabled="true">
