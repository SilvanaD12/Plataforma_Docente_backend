{
  "additionalProperties": false,
  "description": "Cuerpo de POST /generation-requests. La clave de idempotencia va en la cabecera `Idempotency-Key`.",
  "properties": {
    "mode": {
      "description": "`individual`: exactly one type. `sequence`: one step per type, in 5E order.",
      "enum": [
        "individual",
        "sequence"
      ],
      "title": "Mode",
      "type": "string"
    },
    "unitId": {
      "description": "Unit whose processed material is used.",
      "examples": [
        "unidad-1"
      ],
      "title": "Unitid",
      "type": "string"
    },
    "resourceTypes": {
      "description": "`individual` requires exactly one type. In `sequence`, repeated types are ignored and the steps follow the 5E order.",
      "examples": [
        [
          "pregunta_detonante",
          "item_opcion_multiple"
        ]
      ],
      "items": {
        "enum": [
          "pregunta_detonante",
          "sondeo_diagnostico",
          "guia_exploracion",
          "caso_indagacion",
          "explicacion",
          "glosario",
          "ejercicio_aplicacion",
          "item_opcion_multiple",
          "audio_detonante",
          "imagen_ilustrativa",
          "diagrama_proceso",
          "exploracion_guiada",
          "reto_prediccion",
          "mapa_conceptual",
          "infografia",
          "podcast_resumen",
          "caso_aplicado",
          "emparejamiento",
          "ordenar_pasos",
          "verdadero_falso",
          "completar_espacios"
        ],
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Resourcetypes",
      "type": "array"
    },
    "quantity": {
      "default": 1,
      "description": "Common quantity for every type.",
      "maximum": 5,
      "minimum": 1,
      "title": "Quantity",
      "type": "integer"
    },
    "outcomeId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Learning outcome of the unit, optional.",
      "title": "Outcomeid"
    },
    "difficulty": {
      "default": "intermedia",
      "enum": [
        "basica",
        "intermedia",
        "avanzada"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "optionCount": {
      "default": 4,
      "description": "Options per multiple-choice item.",
      "maximum": 5,
      "minimum": 2,
      "title": "Optioncount",
      "type": "integer"
    },
    "topK": {
      "default": 10,
      "description": "Chunks retrieved from the material.",
      "maximum": 50,
      "minimum": 1,
      "title": "Topk",
      "type": "integer"
    },
    "evidenceThreshold": {
      "default": 0.6,
      "description": "Minimum share of a claim's words that its cited chunks must contain.",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Evidencethreshold",
      "type": "number"
    },
    "instructions": {
      "default": "",
      "description": "Free text from the teacher.",
      "maxLength": 500,
      "title": "Instructions",
      "type": "string"
    },
    "audience": {
      "default": "",
      "examples": [
        "Tercer ciclo"
      ],
      "maxLength": 200,
      "title": "Audience",
      "type": "string"
    },
    "competency": {
      "default": "",
      "maxLength": 200,
      "title": "Competency",
      "type": "string"
    },
    "modalities": {
      "default": [
        "Textual"
      ],
      "description": "Only text in this delivery.",
      "items": {
        "const": "Textual",
        "type": "string"
      },
      "maxItems": 1,
      "title": "Modalities",
      "type": "array"
    }
  },
  "required": [
    "mode",
    "unitId",
    "resourceTypes"
  ],
  "title": "StartGenerationRequest",
  "type": "object"
}